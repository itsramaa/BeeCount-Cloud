{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi"
    },
    "web": {
      "root": "frontend/apps/web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "app" }
    },
    {
      "source": "/.well-known/(.*)",
      "destination": { "service": "app" }
    },
    {
      "source": "/healthz",
      "destination": { "service": "app" }
    },
    {
      "source": "/ready",
      "destination": { "service": "app" }
    },
    {
      "source": "/metrics",
      "destination": { "service": "app" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
